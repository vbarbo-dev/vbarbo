---
import { ArrowUp } from 'lucide-astro';
const { footer } = Astro.props;
---

<footer class="footer container">
  <div class="copyright">
    <div class="copy">{footer.copy}</div>
    <div class="rights">{footer.rights}</div>
  </div>

  <button class="back-to-top" data-back-to-top>
    {footer.top}
    <ArrowUp />
  </button>
</footer>

<script src="../../../scripts/backTop.ts"></script>