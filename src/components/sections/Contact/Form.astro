---
const { contact } = Astro.props;
---

<form class="contact-form" data-contact-form>
  <input
    type="text"
    name="website"
    tabindex="-1"
    autocomplete="off"
    style="display:none;"
  >

  <div class="inputs">
    <input type="text" name="name" class="input reveal-item" required placeholder={ contact.formName }>
    <input type="email" name="email" class="input reveal-item" required placeholder={ contact.formEmail }>
  </div>

  <div class="text">
    <textarea name="message" class="textarea reveal-item" required placeholder={ contact.formMessage }></textarea>
  </div>

  <button class="btn reveal-item" type="submit">{ contact.formButton }</button>
</form>
