---
import { Linkedin, Github, ExternalLink, ChevronRight } from 'lucide-astro';
const { contact, links } = Astro.props;
---

<div class="contact-social">
  <div class="top">
    <div class="text">{ contact.findMe }</div>

    <div class="socials">
      <a href={links.linkedin} title="LinkedIn" target="_blank" rel="noopener noreferrer" class="card reveal-item">
        <div class="social"><div class="icon"><Linkedin /></div> LinkedIn</div>
        <div class="external"><ExternalLink /></div>
      </a>
      <a href={links.github} target="_blank" rel="noopener noreferrer" title="GitHub" class="card reveal-item">
        <div class="social"><div class="icon"><Github /></div> GitHub</div>
        <div class="external"><ExternalLink /></div>
      </a>
    </div>
  </div>

  <div class="bottom">
    <div class="text">{ contact.mail }</div>
    <a href=`mailto:${links.email}` title="E-mail" class="email">{links.email} <ChevronRight /></a>
  </div>
</div>