---
import ContactHead from "./ContactHead.astro";
import Form from "./Form.astro";
import Social from "./Social.astro";
const { contact, links } = Astro.props;
---

<section class="section contact container">
  <div class="anchor" id="contact"></div>
  <ContactHead  contact={contact}/>

  <div class="content">
    <Form contact={contact} />
    <Social contact={contact} links={links} />
  </div>
</section>
