---
import Menu from "./Menu.astro"
import Actions from "./Actions.astro"
import Logo from "./Logo.astro";
const { t, lang } = Astro.props;
---

<header class="header">
  <nav class="container">
    <Logo t={t} />
    <Menu t={t} lang={lang} />
    <Actions t={t} lang={lang} />
  </nav>
</header>

<script src="../../../scripts/menu.ts"></script>