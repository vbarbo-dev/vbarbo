---
import Menu from "./Menu.astro"
import Actions from "./Actions.astro"
import Logo from "./Logo.astro";
const { t, menu, lang } = Astro.props;
---

<header class="header">
  <nav class="container">
    <Logo />
    <Menu menu={menu} />
    <Actions actions={t} lang={lang} />
  </nav>
</header>

<script src="../../../scripts/menu.ts"></script>