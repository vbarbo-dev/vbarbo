---
import type { Menu } from '../../../i18n/types';

interface Props {
  menu: Menu[];
}

const { menu } = Astro.props as Props;
---

<ul class="menu">
  {menu.map((item) => {
    return(
      <li class="menu-item" data-link={item.link.replace('#', '')}>
        <a href={item.link} title={item.title}>{item.title}</a>
      </li>
    )
  })}
</ul>