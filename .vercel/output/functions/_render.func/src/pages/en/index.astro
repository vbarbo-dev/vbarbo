---
import { en } from '../../i18n/en';

const t = en;
const lang = 'en';

// Layout - Header
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/sections/Header/Header.astro';

// Sections
import Hero from '../../components/sections/Hero/Hero.astro';
import About from '../../components/sections/About/About.astro';
import Expertise from '../../components/sections/Expertise/Expertise.astro';
import Technical from '../../components/sections/Technical/Technical.astro';
import Experience from '../../components/sections/Experience/Experience.astro';
import Projects from '../../components/sections/Projects/Projects.astro';
import Contact from '../../components/sections/Contact/Contact.astro';

// Footer
import Footer from '../../components/sections/Footer/Footer.astro'
---

<Layout>
  <Header menu={t.menu} lang={lang} />

  <main>
    <Hero hero={t.hero} links={t.links} lang={lang} />
    <About about={t.about} lang={lang} />
    <Expertise expertise={t.expertise}, lang={lang} />
    <Technical technical={t.technical}, lang={lang} />
    <Experience experience={t.experience}, lang={lang} />
    <!-- <Projects projects={t.projects}, lang={lang} /> -->
    <Contact contact={t.contact} links={t.links} lang={lang} />
  </main>

  <Footer footer={t.footer} lang={lang} />
</Layout>